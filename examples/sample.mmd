flowchart LR
  subgraph WEB["Web 边缘 | 双活 · LAN"]
    direction TB
    subgraph WEB_NGINX["nginx | 80/443"]
      WEB_NGINX_PROXY["反代层 | TLS 终结"]
      WEB_NGINX_STATIC["静态资源 | 缓存 7d"]
    end
    WEB_GW["API 网关 | QPS 3k"]
  end
  subgraph APP["应用服务器 | 4C8G ×2"]
    direction TB
    subgraph APP_ORDERS["订单服务"]
      APP_ORDERS_CREATE["下单 | 事务"]
      APP_ORDERS_RESERVE["库存扣减"]
    end
    APP_USERS["用户服务 | JWT"]
  end
  subgraph DATA["数据层 | SSD RAID"]
    direction TB
    DATA_PG["PostgreSQL 主库 | 5432"]
    DATA_REPLICA["只读副本 | 延迟 <5s"]
  end
  subgraph OPS["运维 | 跳板机"]
    direction TB
    subgraph OPS_CRON["cron 定时器 | ~10 任务"]
      OPS_CRON_RECON["夜批对账 | 02:00"]
      OPS_CRON_REPORT["报表推送 | 08:00"]
    end
    OPS_BI["BI 看板 | 9001"]
  end

  WEB_NGINX_PROXY -->|call| WEB_GW
  WEB_GW -->|call| APP_ORDERS
  WEB_GW -->|call| APP_USERS
  APP_ORDERS_CREATE -->|"call · 下单写入"| DATA_PG
  APP_ORDERS_RESERVE -->|call| DATA_PG
  DATA_PG ==>|"sync · 流复制 实时"| DATA_REPLICA
  OPS_CRON_RECON -.->|"job · 02:00 每日"| DATA_PG
  OPS_CRON_REPORT -.->|"job · 08:00 工作日"| DATA_REPLICA
  OPS_BI -.-|"data · 只读 5min 延迟"| DATA_REPLICA
